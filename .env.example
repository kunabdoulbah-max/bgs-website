# Port du serveur (facultatif, défaut 3000)
PORT=3000

# Webhook de notification des demandes (facultatif)
# Exemple : Slack, Discord ou votre propre endpoint HTTPS
CONTACT_WEBHOOK_URL=

# Adresse de notification (facultative, documentation seulement)
CONTACT_EMAIL=

# Sécurité de la session administrateur (à activer en HTTPS)
# COOKIE_SECURE=true

# Base PostgreSQL gratuite Neon (hébergement)
# Sans cette variable, le site utilise les fichiers data/*.json en local.
# Format : postgresql://utilisateur:mot-de-passe@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
